node_modules/
.netlify/

# No secrets belong in this project — the published viewer reads static JSON and calls no API.
# .env is ignored anyway, so an accidental copy from the engine folder can never be committed.
.env
.env.local

# Build output. `npm run build` regenerates it from the engine's runs/ folder, but it is committed
# so the repository is self-contained: Netlify builds without needing the engine, and anyone who
# clones this gets a working site. Re-run the build and commit again after each new audit.
